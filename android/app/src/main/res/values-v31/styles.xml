<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ forces a system splash and only allows a small
         center image there. Per the owner's choice: white background
         with the full blue-text "Let's PADEL" logo, flowing into the
         app's identical white splash with the big logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
