<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ forces a system splash and only allows a SMALL
         center icon there — a full-size logo image is not possible on
         that first frame. So we keep it plain white (transparent
         icon); the app's own splash right after shows the big
         "Let's PADEL" logo — the only logo screen the user sees. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
