<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces the classic launch drawable with a system
         splash. We swap its center icon for the full "Let's PADEL"
         logo (padded to survive the circular mask), so the first
         screen looks identical to the app's own splash — one screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
