rules_version = '2';

// Security rules for the padel booking app.
// Deploy from the Firebase console: Firestore Database -> Rules -> paste -> Publish
// (or `firebase deploy --only firestore:rules` if you use the Firebase CLI).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: each user manages their own; role changes only by admin
    // (or manually in the console). Admins can read all profiles.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role)
      );
    }

    // Branches, courts and prices: everyone signed in can read;
    // only the owner (admin role) can change them — including the one-time
    // "Initialize club data" seeding, so grant yourself admin first (SETUP.md).
    match /branches/{branchId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /courts/{courtId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Happy hour rules: readable by customers (to show prices), admin-managed.
    match /happyHourRules/{ruleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Bookings: customers create their own and may cancel their own;
    // admins see and manage everything.
    match /bookings/{bookingId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isBlock == false &&
        request.resource.data.status == 'confirmed'
      );
      // Customers may cancel their own booking, or attach/detach an
      // open match to it — nothing else.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid && (
          (request.resource.data.status == 'cancelled' &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])) ||
          request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isOpenMatch', 'openMatchId'])
        )
      );
      allow delete: if isAdmin();
    }

    // Open matches: anyone signed in can browse and join (players/status
    // only); creating requires being the creator; admins can do anything.
    match /openMatches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['players', 'status']));
      allow delete: if isAdmin();
    }

    // Vouchers: customers read them (to browse and apply) and the booking
    // transaction may only bump the usage counters; owner manages them.
    match /vouchers/{code} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uses', 'totalDiscount', 'usesByUser']));
    }

    // Tournaments: everyone signed in reads; the owner manages them.
    // Customers may register themselves (entry create with their own uid)
    // and the tournament's counters move only via the register transaction.
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['entriesCount', 'waitlistCount']));

      match /entries/{entryId} {
        allow read: if signedIn();
        allow create: if isAdmin() || (signedIn() &&
          request.resource.data.uids.hasAny([request.auth.uid]));
        allow update, delete: if isAdmin();
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Day sheets (busy intervals per court per day): readable by all
    // signed-in users so the app can show availability; written by the
    // booking transaction of any signed-in user or by admins.
    match /courtDays/{dayId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
